{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "nmap", "cmd": "nmap", "args": true },
        { "name": "hashcat", "cmd": "hashcat", "args": true },
        { "name": "john", "cmd": "john", "args": true },
        { "name": "netcat", "cmd": "nc", "args": true },
        { "name": "curl", "cmd": "curl", "args": true },
        { "name": "ping", "cmd": "ping", "args": true },
        { "name": "dig", "cmd": "dig", "args": true },
        { "name": "whois", "cmd": "whois", "args": true },
        { "name": "gobuster", "cmd": "gobuster", "args": true },
        { "name": "ffuf", "cmd": "ffuf", "args": true },
        { "name": "python3", "cmd": "python3", "args": true },
        { "name": "bash", "cmd": "bash", "args": true }
      ]
    }
  ]
}
